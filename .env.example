# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated emails that receive Admin role on first Google sign-in
GOOGLE_ADMIN_EMAILS=admin@minearchive.co

# Signs the session cookie (HMAC). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Enables the admin123/user123 demo password shortcut. Leave UNSET in production.
ALLOW_DEMO_LOGIN=

# Production debugging (local/staging only — leave UNSET on public production)
# ENABLE_SOURCE_MAPS=true  → browser + server source maps in `next build`
# MINEARCHIVE_DEBUG=true   → verbose structured logs via lib/logger.js
# DEBUG=minearchive:*      → same verbose namespace filter
ENABLE_SOURCE_MAPS=
MINEARCHIVE_DEBUG=

# -----------------------------------------------------------------------------
# Database — local Docker (default) OR Supabase
# -----------------------------------------------------------------------------
# Local PostGIS (docker compose up db):
DATABASE_URL=postgresql://minearchive_user:minearchive_pass@localhost:5432/minearchive_db?schema=public
DIRECT_URL=postgresql://minearchive_user:minearchive_pass@localhost:5432/minearchive_db?schema=public

# Supabase (Project Settings → Database → Connect):
# Use the *Transaction* pooler for DATABASE_URL (port 6543) and the *Direct*
# connection for DIRECT_URL (port 5432). Prisma needs both.
#
# DATABASE_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
#
# Then run: npm run db:supabase

# Optional — Supabase JS client (Storage / future features)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
