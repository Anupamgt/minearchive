# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated emails that receive Admin role on first Google sign-in
GOOGLE_ADMIN_EMAILS=admin@minearchive.co

# Signs the session cookie (HMAC). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Enables the admin123/user123 demo password shortcut. Leave UNSET in production.
ALLOW_DEMO_LOGIN=

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/minearchive
