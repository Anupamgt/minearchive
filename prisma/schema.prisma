generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled URL for the app (Supabase transaction pooler :6543 + ?pgbouncer=true)
  url       = env("DATABASE_URL")
  // Direct/session URL for migrations & PostGIS setup (Supabase :5432)
  directUrl = env("DIRECT_URL")
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String?    // null for Google OAuth users
  role         String     @default("user") // admin, user
  status       String     @default("active") // active, disabled
  lastLogin    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  auditLogs     AuditLog[]
  assignedSites UserSiteAssignment[]
}

model Node {
  id            String    @id @default(uuid())
  name          String    @unique
  description   String?
  status        String    @default("proposed") // active, proposed, archived
  locationLabel String?
  createdBy     String?
  approvedBy    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  uploads       Upload[]
  assignedUsers UserSiteAssignment[]
}

/// Many-to-many: a field user can be assigned to several monitoring areas,
/// and a site can have several assigned users. Admins ignore this table and
/// see every site. Enforcement is in the Next.js APIs (lib/site-access.js),
/// not Supabase RLS.
model UserSiteAssignment {
  userId     String
  nodeId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([userId, nodeId])
  @@index([nodeId])
}

model Upload {
  id           String    @id @default(uuid())
  nodeId       String?
  node         Node?     @relation(fields: [nodeId], references: [id])
  uploadedBy   String?
  uploadDate   DateTime  @default(now())
  surveyDate   DateTime?
  category     String?
  notes        String?
  kmlFilePath  String?
  
  isDeleted    Boolean   @default(false)
  deletedBy    String?
  deletedAt    DateTime?

  geometries   UploadGeometry[]
  attachments  UploadAttachment[]
}

// Prisma doesn't natively support PostGIS geometry columns well. 
// We use Unsupported("geometry") and raw SQL for queries.
model UploadGeometry {
  id              String   @id @default(uuid())
  uploadId        String
  upload          Upload   @relation(fields: [uploadId], references: [id])

  // Storing geometry as Unsupported
  geom            Unsupported("geometry(Polygon, 4326)")?

  // Placemark name from the KML. Null when the source had no usable name.
  name            String?
  // Every other KML attribute (ExtendedData etc). Kept verbatim so the display
  // name can be re-derived later without re-uploading the original file.
  sourceProperties Json?
  // Position within a placemark that produced several polygons (MultiGeometry).
  partIndex       Int?
  partCount       Int?

  areaHectares    Float?
  perimeterMeters Float?
}

model UploadAttachment {
  id           String   @id @default(uuid())
  uploadId     String
  upload       Upload   @relation(fields: [uploadId], references: [id])
  filePath     String
  fileType     String
  fileSize     Int
  originalName String
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  targetType String?
  targetId   String?
  details    String?
  ipAddress  String?
  timestamp  DateTime @default(now())
}
